{
  "name": "myeot-johang-ideora",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "몇 조항이더라 — 조달청 실무자용 법령 즉시검색 + 위임·인용 관계 그래프 (내부망/오프라인)",
  "scripts": {
    "collect": "node src/collect.mjs",
    "extract": "node src/extract.mjs",
    "build": "node src/build.mjs",
    "annex": "node src/fetch-annexes.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs",
    "serve": "node --version >/dev/null && python3 -m http.server 8080 --directory web",
    "tauri:icon": "node src-tauri/gen-icons.mjs",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build"
  }
}
