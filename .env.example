# 법제처 국가법령정보 오픈API 자격증명
#
# 이 파일을 `.env` 로 복사한 뒤 값을 채우세요. `.env` 는 .gitignore 에 있습니다.
# 값을 이 파일(.env.example)에 적지 마세요 — 커밋됩니다.
#
# OC = 법제처 오픈API에 등록한 이메일의 @ 앞부분.
#      예) 신청 이메일이 hong@korea.kr 이면  LAW_API_OC=hong
#      신청: https://open.law.go.kr  →  오픈API 신청 → 승인 후 사용
#
# 일회성으로 쓰려면 환경변수로 넘겨도 됩니다:
#   LAW_API_OC=hong node src/collect.mjs

LAW_API_OC=
