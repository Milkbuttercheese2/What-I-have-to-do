{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window. core:window:default is getters-only, so the custom titlebar controls (v2.5.1, decorations:false) need explicit minimize/toggle-maximize/close/start-dragging grants. v3.8.25: every app command (allow-*) is granted here only — see build.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default",
    "allow-load-all",
    "allow-save-all",
    "allow-save-fields",
    "allow-save-presets",
    "allow-save-id-kinds",
    "allow-save-settings",
    "allow-save-phonebook",
    "allow-doc-set-roots",
    "allow-doc-read-text",
    "allow-doc-write-text",
    "allow-doc-list",
    "allow-doc-read",
    "allow-doc-abs",
    "allow-doc-move",
    "allow-doc-create",
    "allow-doc-create-doc",
    "allow-doc-import",
    "allow-doc-trash",
    "allow-doc-copy",
    "allow-doc-search",
    "allow-doc-search-warm",
    "allow-key-shift-down",
    "allow-doc-rename",
    "allow-doc-rename-root",
    "allow-doc-preview-open",
    "allow-doc-preview-place",
    "allow-doc-preview-show",
    "allow-doc-preview-close",
    "allow-phonebook-search",
    "allow-phonebook-list",
    "allow-backup-export",
    "allow-backup-import",
    "allow-get-data-dir",
    "allow-choose-data-dir",
    "allow-restart-app",
    "allow-quit-now",
    "allow-emergency-dump",
    "allow-focus-main-window",
    "allow-alarm-attention",
    "allow-save-text-file",
    "allow-save-binary-file",
    "allow-import-backup-file",
    "allow-cancel-pending-import",
    "allow-pick-file-path",
    "allow-pick-folder-path",
    "allow-open-file-path",
    "allow-reveal-file-path",
    "allow-quick-search",
    "allow-resize-capture",
    "allow-set-capture-form-mode",
    "allow-set-ui-scale",
    "allow-set-autostart"
  ]
}
